mncs 0.18;

// MNCS-owned debugger semantics. The launcher supplies only typed facts from
// the external execution boundary. This module decides the semantic failure
// class, stop policy, and evidence escalation vocabulary.
module mncs.debug;

use mncs.std.process.v1;
use mncs.std.application.v1;
use mncs.commons.family.artifact.v1;
use mncs.commons.family.contracts.v1 as contracts;
use mncs.core.sequences.v1 as sequences;
use mncs.test.assertions;
use mncs.test.provider_protocol.v1 as provider_protocol;

enum RuntimeStatus {
    Returned,
    RuntimeFailure,
    Unsupported,
    BudgetExhausted,
    InvalidRequest,
    CompileFailure,
    TestFailure,
    InfrastructureFailure,
}

enum DebugOutcome {
    Success,
    CompileFailure,
    RuntimeFailure,
    AssertionFailure,
    EffectFailure,
    TimeoutOrBudgetExhaustion,
    Unsupported,
    InvalidInvocation,
    InfrastructureFailure,
    TestFailure,
}

enum SufficiencyStatus { Sufficient, Ambiguous, Unsupported }
enum DiagnosticOperation { NoOperation, Trace, Provenance, Replay, Minimization }
enum EvidenceGap {
    NoGap,
    FailureIdentity,
    OperationIdentity,
    ObservationCompleteness,
    Provenance,
    Replay,
    Minimization,
}

// These vocabularies are the typed boundary for bounded artifact observations.
// Python may parse JSON and normalize a literal field into one of these
// nominal values, but only this module decides which values establish a
// debugger fact.
enum EvidencePresence { Absent, Present }
enum TraceCompleteness { Unknown, Partial, Complete, Truncated }
enum ProvenanceClaimKind { Other, OperationIdentity, ValueOriginChain, EffectProvenance }
enum ProvenanceClaimStatus { Unknown, Claimed, Available, Observed }
enum ReplayStatus { Unknown, Available, Replayed, Reproduced, Mismatch }
enum MinimizationStatus { Unknown, Candidate, Reduced, NoReduction, Blocked }

record DecisionInput {
    runtime_status: RuntimeStatus,
    assertion_failed: bool,
    effect_failed: bool,
}

// Debug owns the reason for a bounded replay/process request; the generic
// runtime owns executable admission, argv-only spawning, environment clearing,
// capture limits, deadline enforcement, and fail-closed status realization.
// This is intentionally a typed application effect, not a Debug-specific CLI
// operation.
fn replay_process(request: ProcessRequest) -> (result: ProcessResult)
    capability debug_process
    effect process_run authorized_by debug_process
{
    return process_run(request);
}

record Decision {
    outcome: DebugOutcome,
    should_stop: bool,
}

record SufficiencyInput {
    has_failure_identity: bool,
    has_operation_identity: bool,
    observation_complete: bool,
    provenance_observed: bool,
    replay_required: bool,
    minimization_required: bool,
}

record SufficiencyDecision {
    status: SufficiencyStatus,
    next_operation: DiagnosticOperation,
    evidence_gap: EvidenceGap,
    sufficient: bool,
}

// Artifact parsing remains a bounded host transport concern. Once the host
// has extracted literal observations, this native reducer owns the semantic
// combination of those observations into debugger evidence facts.
record TraceObservation {
    failure_anchor: EvidencePresence,
    operation_identity: EvidencePresence,
    completeness: TraceCompleteness,
}

record ProvenanceObservation {
    kind: ProvenanceClaimKind,
    status: ProvenanceClaimStatus,
}

record EvidenceFactsInput {
    traces: [TraceObservation; 16],
    trace_count: u64,
    trace_overflow: bool,
    provenance: [ProvenanceObservation; 64],
    provenance_count: u64,
    provenance_overflow: bool,
    replay: [ReplayStatus; 16],
    replay_count: u64,
    replay_overflow: bool,
    minimization: [MinimizationStatus; 16],
    minimization_count: u64,
    minimization_overflow: bool,
}

record EvidenceFacts {
    failure_anchor_present: bool,
    operation_identity_present: bool,
    observation_complete: bool,
    provenance_binding_present: bool,
    replay_established: bool,
    replay_mismatch: bool,
    minimization_established: bool,
}

// The bounded diagnostic loop is a native reducer over observations.  The
// launcher may acquire a trace, provenance, replay, or minimization artifact
// between calls, but it does not decide which operation is next or whether
// the evidence is sufficient.  ``step_budget`` is intentionally bounded so
// a host cannot turn this semantic surface into an unbounded policy loop.
record DiagnosticLoopInput {
    evidence: EvidenceFactsInput,
    replay_required: bool,
    minimization_required: bool,
    step_budget: u64,
}

record DiagnosticLoopDecision {
    status: SufficiencyStatus,
    next_operation: DiagnosticOperation,
    evidence_gap: EvidenceGap,
    sufficient: bool,
    stop: bool,
    bounded_steps: u64,
    replay_established: bool,
    replay_mismatch: bool,
    minimization_established: bool,
}

// Generic artifact ingress keeps the external JSON envelope out of Debug's
// semantic layer.  The decoder admits this Commons/language-owned nominal
// record, then Debug applies the same reducer used by the diagnostic loop.
// The host may supply the bounded path and capability grant, but it cannot
// replace the typed observation stream with a verdict or sufficiency flag.
fn evidence_facts_artifact_app(context: ApplicationContext) -> (result: ApplicationExit)
    capability debug_artifact
    effect structured_read authorized_by debug_artifact
    effect structured_write authorized_by debug_artifact
{
    if !context_is_bounded(context) {
        return failure([98, 111, 117, 110, 100, 115], 2);
    }
    if context.argv_count < 2 {
        return failure([97, 114, 103, 118, 32, 114, 101, 113, 117, 105, 114, 101, 115, 32, 105, 110, 112, 117, 116, 32, 97, 110, 100, 32, 111, 117, 116, 112, 117, 116], 2);
    }
    let input_schema: [byte; 33] = [109, 110, 99, 115, 46, 100, 101, 98, 117, 103, 46, 101, 118, 105, 100, 101, 110, 99, 101, 45, 102, 97, 99, 116, 115, 45, 105, 110, 112, 117, 116, 47, 49];
    let output_schema: [byte; 27] = [109, 110, 99, 115, 46, 100, 101, 98, 117, 103, 46, 101, 118, 105, 100, 101, 110, 99, 101, 45, 102, 97, 99, 116, 115, 47, 49];
    let input: EvidenceFactsInput = structured_read(context.argv[0], input_schema);
    let facts: EvidenceFacts = evidence_facts(input);
    let published: u64 = structured_write(context.argv[1], output_schema, facts);
    if published == 0 {
        return failure([115, 116, 114, 117, 99, 116, 117, 114, 101, 100, 32, 112, 117, 98, 108, 105, 99, 97, 116, 105, 111, 110, 32, 119, 97, 115, 32, 101, 109, 112, 116, 121], 3);
    }
    return success([]);
}

// Direct raw TestResult ingress. The generic codec decodes the actual
// mncs.test-result/1 document into the Commons-owned wire view; Debug, not
// Python, interprets its verdict and creates the bounded observation needed
// by the native evidence reducer. Missing trace/provenance remains an honest
// partial observation and therefore preserves progressive escalation.
fn test_result_artifact_app(context: ApplicationContext) -> (result: ApplicationExit)
    capability debug_artifact
    effect structured_read authorized_by debug_artifact
    effect structured_write authorized_by debug_artifact
{
    if !context_is_bounded(context) {
        return failure([98, 111, 117, 110, 100, 115], 2);
    }
    if context.argv_count < 2 {
        return failure([97, 114, 103, 118, 32, 114, 101, 113, 117, 105, 114, 101, 115, 32, 105, 110, 112, 117, 116, 32, 97, 110, 100, 32, 111, 117, 116, 112, 117, 116], 2);
    }
    let test_schema: [byte; 18] = [109, 110, 99, 115, 46, 116, 101, 115, 116, 45, 114, 101, 115, 117, 108, 116, 47, 49];
    let facts_schema: [byte; 27] = [109, 110, 99, 115, 46, 100, 101, 98, 117, 103, 46, 101, 118, 105, 100, 101, 110, 99, 101, 45, 102, 97, 99, 116, 115, 47, 49];
    let test_result: TestResultArtifact = structured_read(context.argv[0], test_schema);
    let failed: bool = match test_result.verdict {
        ArtifactVerdict.FAIL => true,
        ArtifactVerdict.PASS => false,
        ArtifactVerdict.UNKNOWN => false
    };
    let trace: TraceObservation = TraceObservation {
        failure_anchor: select(failed, EvidencePresence.Present, EvidencePresence.Absent),
        operation_identity: EvidencePresence.Absent,
        completeness: TraceCompleteness.Partial
    };
    let input: EvidenceFactsInput = EvidenceFactsInput {
        traces: [trace; 16],
        trace_count: 1,
        trace_overflow: false,
        provenance: [ProvenanceObservation {
            kind: ProvenanceClaimKind.Other,
            status: ProvenanceClaimStatus.Unknown
        }; 64],
        provenance_count: 0,
        provenance_overflow: false,
        replay: [ReplayStatus.Unknown; 16],
        replay_count: 0,
        replay_overflow: false,
        minimization: [MinimizationStatus.Unknown; 16],
        minimization_count: 0,
        minimization_overflow: false
    };
    let facts: EvidenceFacts = evidence_facts(input);
    let published: u64 = structured_write(context.argv[1], facts_schema, facts);
    if published == 0 {
        return failure([112, 117, 98, 108, 105, 115, 104, 32, 102, 97, 105, 108, 101, 100], 3);
    }
    return success([]);
}

// Canonical Actions failure ingress. The five inputs are the provider-owned
// TestResult/CheckResult plus the Commons-owned receipt, evidence manifest,
// and selected proof. Debug interprets their identities and verdicts here;
// Python does not flatten them into a failure boolean or rebuild a witness.
record FailureLineage {
    outcome: DebugOutcome,
    provider_failed: bool,
    check_failed: bool,
    family_failed: bool,
    identity_bindings_valid: bool,
    failure_anchor_present: bool,
    operation_identity_present: bool,
    observation_complete: bool,
    provenance_observed: bool,
    replay_required: bool,
    minimization_required: bool,
    sufficient: bool,
    next_operation: DiagnosticOperation,
    evidence_gap: EvidenceGap,
    provider_result_identity: [byte; 32],
    provider_check_identity: [byte; up_to 256],
    receipt_identity: [byte; 32],
    evidence_identity: [byte; 32],
    proof_identity: [byte; 32],
    artifact_count: u64,
}

// The canonical bounded diagnostic artifact is produced from the native
// failure lineage.  Host code may transport and render this record, but it
// cannot replace the outcome, sufficiency, next operation, or evidence gap
// with a host-side summary.
record DiagnosticArtifact {
    artifact_identity: [byte; 32],
    outcome: DebugOutcome,
    sufficiency: SufficiencyStatus,
    next_operation: DiagnosticOperation,
    evidence_gap: EvidenceGap,
    failure_anchor_present: bool,
    operation_identity_present: bool,
    observation_complete: bool,
    provenance_observed: bool,
    replay_required: bool,
    minimization_required: bool,
    provider_result_identity: [byte; 32],
    provider_check_identity: [byte; up_to 256],
    receipt_identity: [byte; 32],
    evidence_identity: [byte; 32],
    proof_identity: [byte; 32],
    lineage_artifact_count: u64,
}

fn failure_lineage_schema() -> (result: [byte; up_to 64]) {
    return [109, 110, 99, 115, 46, 100, 101, 98, 117, 103, 46, 102, 97, 105, 108, 117, 114, 101, 45, 108, 105, 110, 101, 97, 103, 101, 47, 49];
}

fn debug_bytes_present(value: [byte; 32]) -> (result: bool) {
    return sequences.any_nonzero<32>(value);
}

fn debug_same_bytes(left: [byte; 32], right: [byte; 32]) -> (result: bool) {
    return sequences.equals_bytes<32>(left, right);
}

fn debug_copy_digest(view: [byte; up_to 64]) -> (result: [byte; 32]) {
    let seed: [byte; 32] = [0; 32];
    return copy_span(seed, 0, view, 0, 32);
}

fn provider_failed(value: Verdict) -> (result: bool) {
    return match value {
        Verdict.FAIL => true,
        Verdict.PASS => false,
        Verdict.SKIP => false,
        Verdict.UNSUPPORTED => false,
    };
}

fn provider_passed(value: Verdict) -> (result: bool) {
    return match value {
        Verdict.PASS => true,
        Verdict.FAIL => false,
        Verdict.SKIP => false,
        Verdict.UNSUPPORTED => false,
    };
}

fn family_failed(value: contracts.ContractFamilyVerdict) -> (result: bool) {
    return match value {
        contracts.ContractFamilyVerdict.FAIL => true,
        contracts.ContractFamilyVerdict.PASS => false,
        contracts.ContractFamilyVerdict.UNKNOWN => false,
    };
}

fn family_passed(value: contracts.ContractFamilyVerdict) -> (result: bool) {
    return match value {
        contracts.ContractFamilyVerdict.PASS => true,
        contracts.ContractFamilyVerdict.FAIL => false,
        contracts.ContractFamilyVerdict.UNKNOWN => false,
    };
}

fn evidence_contains_artifact(
    evidence: contracts.EvidenceManifestContract,
    candidate: [byte; 32]
) -> (result: bool) {
    iterate i over evidence.artifact_identities carrying found: bool = false {
        next found = found || sequences.equals_bytes<32>(evidence.artifact_identities[i], candidate);
    }
    return found;
}

fn lineage_bindings_valid(
    test_result: provider_protocol.ProviderTestResult,
    check_result: provider_protocol.ProviderCheckResult,
    receipt: contracts.ReceiptContract,
    evidence: contracts.EvidenceManifestContract,
    proof: contracts.SelectedProofContract
) -> (result: bool)
    capability debug_digest
    effect structured_digest authorized_by debug_digest
{
    let expected_result_identity: [byte; 32] = debug_copy_digest(structured_digest(
        provider_protocol.provider_test_result_identity_material(test_result)
    ));
    let expected_check_identity: [byte; 32] = debug_copy_digest(structured_digest(
        provider_protocol.provider_check_result_identity_material(check_result)
    ));
    return debug_bytes_present(test_result.result_identity)
        && debug_bytes_present(check_result.result_identity)
        && debug_bytes_present(receipt.receipt_identity)
        && debug_bytes_present(evidence.evidence_identity)
        && debug_bytes_present(proof.proof_identity)
        && debug_bytes_present(test_result.execution_identity)
        && debug_bytes_present(test_result.evidence_identity)
        && debug_bytes_present(check_result.execution_identity)
        && debug_bytes_present(check_result.evidence_identity)
        && debug_same_bytes(test_result.result_identity, check_result.test_result_identity)
        && debug_same_bytes(test_result.execution_identity, check_result.execution_identity)
        && debug_same_bytes(test_result.evidence_identity, check_result.evidence_identity)
        && debug_same_bytes(test_result.result_identity, expected_result_identity)
        && debug_same_bytes(check_result.result_identity, expected_check_identity)
        && debug_same_bytes(receipt.test_result_identity, test_result.result_identity)
        && debug_same_bytes(receipt.check_result_identity, check_result.result_identity)
        && debug_same_bytes(receipt.execution_identity, test_result.execution_identity)
        && debug_same_bytes(receipt.evidence_identity, test_result.evidence_identity)
        && debug_same_bytes(evidence.test_result_identity, test_result.result_identity)
        && debug_same_bytes(evidence.check_result_identity, check_result.result_identity)
        && debug_same_bytes(evidence.execution_identity, test_result.execution_identity)
        && evidence_contains_artifact(evidence, test_result.result_identity)
        && proof.selected_check_identities.len > 0;
}

fn lineage_sufficient_for_pass(
    family_failed_value: bool,
    bindings_valid: bool,
    test_result: provider_protocol.ProviderTestResult,
    check_result: provider_protocol.ProviderCheckResult,
    receipt: contracts.ReceiptContract,
    proof: contracts.SelectedProofContract
) -> (result: bool) {
    return !family_failed_value
        && bindings_valid
        && provider_passed(test_result.native_result.verdict)
        && provider_passed(check_result.verdict)
        && family_passed(receipt.verdict)
        && family_passed(proof.verdict)
        && proof.sufficient;
}

fn actions_failure_artifact_app(context: ApplicationContext) -> (result: ApplicationExit)
    capability debug_artifact
    capability debug_digest
    effect structured_read authorized_by debug_artifact
    effect structured_read_identity authorized_by debug_artifact
    effect structured_write authorized_by debug_artifact
    effect structured_digest authorized_by debug_digest
{
    if !context_is_bounded(context) || context.argv_count < 6 {
        return failure([97, 114, 103, 118, 32, 114, 101, 113, 117, 105, 114, 101, 115, 32, 54, 32, 102, 97, 105, 108, 117, 114, 101, 32, 97, 114, 116, 105, 102, 97, 99, 116, 32, 112, 97, 116, 104, 115], 2);
    }
    let extension_policy: [byte; up_to 128] = contracts.identity_extension_policy();
    let provider_result: provider_protocol.ProviderTestResult = structured_read_identity(
        context.argv[0],
        provider_protocol.provider_result_schema(),
        extension_policy
    );
    let provider_check: provider_protocol.ProviderCheckResult = structured_read_identity(
        context.argv[1],
        provider_protocol.provider_check_schema(),
        extension_policy
    );
    let receipt: contracts.ReceiptContract = structured_read_identity(
        context.argv[2],
        contracts.receipt_schema(),
        extension_policy
    );
    let evidence: contracts.EvidenceManifestContract = structured_read_identity(
        context.argv[3],
        contracts.evidence_manifest_schema(),
        extension_policy
    );
    let proof: contracts.SelectedProofContract = structured_read_identity(
        context.argv[4],
        contracts.selected_proof_schema(),
        extension_policy
    );
    let provider_is_failed: bool = provider_failed(provider_result.native_result.verdict);
    let check_is_failed: bool = provider_failed(provider_check.verdict);
    let receipt_is_failed: bool = family_failed(receipt.verdict);
    let proof_is_failed: bool = family_failed(proof.verdict);
    let failed: bool = provider_is_failed || check_is_failed || receipt_is_failed || proof_is_failed;
    let bindings_valid: bool = lineage_bindings_valid(provider_result, provider_check, receipt, evidence, proof);
    let operation_identity: bool = debug_bytes_present(provider_result.execution_identity)
        && debug_same_bytes(provider_result.execution_identity, provider_check.execution_identity)
        && debug_same_bytes(provider_result.execution_identity, receipt.execution_identity)
        && debug_same_bytes(provider_result.execution_identity, evidence.execution_identity);
    let pass_sufficient: bool = lineage_sufficient_for_pass(failed, bindings_valid, provider_result, provider_check, receipt, proof);
    let decision: SufficiencyDecision = select(
        pass_sufficient,
        make_sufficiency(SufficiencyStatus.Sufficient, DiagnosticOperation.NoOperation, EvidenceGap.NoGap, true),
        sufficiency(SufficiencyInput {
            has_failure_identity: failed && bindings_valid,
            has_operation_identity: operation_identity,
            observation_complete: false,
            provenance_observed: false,
            replay_required: false,
            minimization_required: false,
        })
    );
    let outcome: DebugOutcome = select(
        failed && bindings_valid,
        DebugOutcome.TestFailure,
        select(bindings_valid, DebugOutcome.Success, DebugOutcome.InfrastructureFailure)
    );
    let lineage: FailureLineage = FailureLineage {
        outcome: outcome,
        provider_failed: provider_is_failed,
        check_failed: check_is_failed,
        family_failed: failed,
        identity_bindings_valid: bindings_valid,
        failure_anchor_present: failed && bindings_valid,
        operation_identity_present: operation_identity,
        observation_complete: false,
        provenance_observed: false,
        replay_required: false,
        minimization_required: false,
        sufficient: decision.sufficient,
        next_operation: decision.next_operation,
        evidence_gap: decision.evidence_gap,
        provider_result_identity: provider_result.result_identity,
        provider_check_identity: provider_check.check_identity,
        receipt_identity: receipt.receipt_identity,
        evidence_identity: evidence.evidence_identity,
        proof_identity: proof.proof_identity,
        artifact_count: 5,
    };
    let published: u64 = structured_write(context.argv[5], failure_lineage_schema(), lineage);
    if published == 0 {
        return failure([100, 101, 98, 117, 103, 32, 108, 105, 110, 101, 97, 103, 101, 32, 112, 117, 98, 108, 105, 115, 104, 32, 102, 97, 105, 108, 101, 100], 3);
    }
    return success([]);
}

fn diagnostic_artifact_schema() -> (result: [byte; up_to 64]) {
    return [109, 110, 99, 115, 46, 100, 101, 98, 117, 103, 46, 100, 105, 97, 103, 110, 111, 115, 116, 105, 99, 45, 97, 114, 116, 105, 102, 97, 99, 116, 47, 49];
}

fn diagnostic_artifact_app(context: ApplicationContext) -> (result: ApplicationExit)
    capability debug_artifact
    capability debug_digest
    effect structured_read authorized_by debug_artifact
    effect structured_read_identity authorized_by debug_artifact
    effect structured_write authorized_by debug_artifact
    effect structured_digest authorized_by debug_digest
{
    if !context_is_bounded(context) || context.argv_count < 2 {
        return failure([97, 114, 103, 118, 32, 114, 101, 113, 117, 105, 114, 101, 115, 32, 50, 32, 100, 105, 97, 103, 110, 111, 115, 116, 105, 99, 32, 97, 114, 116, 105, 102, 97, 99, 116, 32, 112, 97, 116, 104, 115], 2);
    }
    let extension_policy: [byte; up_to 128] = contracts.identity_extension_policy();
    let lineage: FailureLineage = structured_read_identity(
        context.argv[0],
        failure_lineage_schema(),
        extension_policy
    );
    let material: DiagnosticArtifact = DiagnosticArtifact {
        artifact_identity: [0; 32],
        outcome: lineage.outcome,
        sufficiency: select(lineage.sufficient, SufficiencyStatus.Sufficient, SufficiencyStatus.Ambiguous),
        next_operation: lineage.next_operation,
        evidence_gap: lineage.evidence_gap,
        failure_anchor_present: lineage.failure_anchor_present,
        operation_identity_present: lineage.operation_identity_present,
        observation_complete: lineage.observation_complete,
        provenance_observed: lineage.provenance_observed,
        replay_required: lineage.replay_required,
        minimization_required: lineage.minimization_required,
        provider_result_identity: lineage.provider_result_identity,
        provider_check_identity: lineage.provider_check_identity,
        receipt_identity: lineage.receipt_identity,
        evidence_identity: lineage.evidence_identity,
        proof_identity: lineage.proof_identity,
        lineage_artifact_count: lineage.artifact_count,
    };
    let artifact_identity: [byte; 32] = debug_copy_digest(structured_digest(material));
    let artifact: DiagnosticArtifact = DiagnosticArtifact {
        ..material,
        artifact_identity: artifact_identity
    };
    let published: u64 = structured_write(context.argv[1], diagnostic_artifact_schema(), artifact);
    if published == 0 {
        return failure([100, 105, 97, 103, 110, 111, 115, 116, 105, 99, 32, 97, 114, 116, 105, 102, 97, 99, 116, 32, 112, 117, 98, 108, 105, 115, 104, 32, 102, 97, 105, 108, 101, 100], 3);
    }
    return success([]);
}

fn evidence_facts(input: EvidenceFactsInput) -> (result: EvidenceFacts) {
    let initial: EvidenceFacts = EvidenceFacts {
        failure_anchor_present: false,
        operation_identity_present: false,
        observation_complete: false,
        provenance_binding_present: false,
        replay_established: false,
        replay_mismatch: false,
        minimization_established: false,
    };
    iterate t over input.traces carrying trace_facts: EvidenceFacts = initial {
        let include: bool = (t as i64) < (input.trace_count as i64) && no_overflow(input.trace_overflow);
        next trace_facts = trace_step(trace_facts, input.traces[t], include);
    }
    iterate p over input.provenance carrying provenance_facts: EvidenceFacts = trace_facts {
        let include: bool = (p as i64) < (input.provenance_count as i64) && no_overflow(input.provenance_overflow);
        next provenance_facts = provenance_step(provenance_facts, input.provenance[p], include);
    }
    iterate r over input.replay carrying replay_facts: EvidenceFacts = provenance_facts {
        let include: bool = (r as i64) < (input.replay_count as i64) && no_overflow(input.replay_overflow);
        next replay_facts = replay_step(replay_facts, input.replay[r], include);
    }
    iterate m over input.minimization carrying minimization_facts: EvidenceFacts = replay_facts {
        let include: bool = (m as i64) < (input.minimization_count as i64) && no_overflow(input.minimization_overflow);
        next minimization_facts = minimization_step(minimization_facts, input.minimization[m], include);
    }
    return minimization_facts;
}

fn no_overflow(value: bool) -> (result: bool) {
    if value { return false; }
    return true;
}

fn trace_step(current: EvidenceFacts, observation: TraceObservation, include: bool) -> (result: EvidenceFacts) {
    if include {
        return EvidenceFacts {
            ..current,
            failure_anchor_present: current.failure_anchor_present || is_present(observation.failure_anchor),
            operation_identity_present: current.operation_identity_present || is_present(observation.operation_identity),
            observation_complete: current.observation_complete || is_complete(observation.completeness),
        };
    }
    return current;
}

fn provenance_step(current: EvidenceFacts, observation: ProvenanceObservation, include: bool) -> (result: EvidenceFacts) {
    if include {
        let binding: bool = recognized_provenance(observation.kind) && established_claim(observation.status);
        let operation: bool = operation_claim_observed(observation);
        return EvidenceFacts {
            ..current,
            provenance_binding_present: current.provenance_binding_present || binding,
            operation_identity_present: current.operation_identity_present || operation,
        };
    }
    return current;
}

fn recognized_provenance(kind: ProvenanceClaimKind) -> (result: bool) {
    return match kind {
        ProvenanceClaimKind.OperationIdentity => true,
        ProvenanceClaimKind.ValueOriginChain => true,
        ProvenanceClaimKind.EffectProvenance => true,
        ProvenanceClaimKind.Other => false,
    };
}

fn established_claim(status: ProvenanceClaimStatus) -> (result: bool) {
    return match status {
        ProvenanceClaimStatus.Available => true,
        ProvenanceClaimStatus.Observed => true,
        ProvenanceClaimStatus.Unknown => false,
        ProvenanceClaimStatus.Claimed => false,
    };
}

fn is_present(value: EvidencePresence) -> (result: bool) {
    return match value {
        EvidencePresence.Present => true,
        EvidencePresence.Absent => false,
    };
}

fn is_complete(value: TraceCompleteness) -> (result: bool) {
    return match value {
        TraceCompleteness.Complete => true,
        TraceCompleteness.Unknown => false,
        TraceCompleteness.Partial => false,
        TraceCompleteness.Truncated => false,
    };
}

fn operation_claim_observed(observation: ProvenanceObservation) -> (result: bool) {
    return match observation.kind {
        ProvenanceClaimKind.OperationIdentity => match observation.status {
            ProvenanceClaimStatus.Observed => true,
            ProvenanceClaimStatus.Unknown => false,
            ProvenanceClaimStatus.Claimed => false,
            ProvenanceClaimStatus.Available => false,
        },
        ProvenanceClaimKind.Other => false,
        ProvenanceClaimKind.ValueOriginChain => false,
        ProvenanceClaimKind.EffectProvenance => false,
    };
}

fn replay_step(current: EvidenceFacts, status: ReplayStatus, include: bool) -> (result: EvidenceFacts) {
    if include {
        let established: bool = replay_is_established(status);
        return EvidenceFacts {
            ..current,
            replay_established: current.replay_established || established,
            replay_mismatch: current.replay_mismatch || replay_is_mismatch(status)
        };
    }
    return current;
}

fn minimization_step(current: EvidenceFacts, status: MinimizationStatus, include: bool) -> (result: EvidenceFacts) {
    if include {
        let established: bool = minimization_is_established(status);
        return EvidenceFacts { ..current, minimization_established: current.minimization_established || established };
    }
    return current;
}

fn replay_is_established(status: ReplayStatus) -> (result: bool) {
    return match status {
        ReplayStatus.Replayed => true,
        ReplayStatus.Reproduced => true,
        ReplayStatus.Unknown => false,
        ReplayStatus.Available => false,
        ReplayStatus.Mismatch => false,
    };
}

fn replay_is_mismatch(status: ReplayStatus) -> (result: bool) {
    return match status {
        ReplayStatus.Mismatch => true,
        ReplayStatus.Unknown => false,
        ReplayStatus.Available => false,
        ReplayStatus.Replayed => false,
        ReplayStatus.Reproduced => false,
    };
}

fn minimization_is_established(status: MinimizationStatus) -> (result: bool) {
    return match status {
        MinimizationStatus.Reduced => true,
        MinimizationStatus.NoReduction => true,
        MinimizationStatus.Unknown => false,
        MinimizationStatus.Candidate => false,
        MinimizationStatus.Blocked => false,
    };
}

fn sufficiency(input: SufficiencyInput) -> (result: SufficiencyDecision) {
    if missing(input.has_failure_identity) {
        return make_sufficiency(SufficiencyStatus.Ambiguous, DiagnosticOperation.Trace, EvidenceGap.FailureIdentity, false);
    }
    if missing(input.has_operation_identity) {
        return make_sufficiency(SufficiencyStatus.Ambiguous, DiagnosticOperation.Trace, EvidenceGap.OperationIdentity, false);
    }
    if missing(input.observation_complete) {
        return make_sufficiency(SufficiencyStatus.Ambiguous, DiagnosticOperation.Trace, EvidenceGap.ObservationCompleteness, false);
    }
    if missing(input.provenance_observed) {
        return make_sufficiency(SufficiencyStatus.Ambiguous, DiagnosticOperation.Provenance, EvidenceGap.Provenance, false);
    }
    if input.replay_required {
        return make_sufficiency(SufficiencyStatus.Ambiguous, DiagnosticOperation.Replay, EvidenceGap.Replay, false);
    }
    if input.minimization_required {
        return make_sufficiency(SufficiencyStatus.Ambiguous, DiagnosticOperation.Minimization, EvidenceGap.Minimization, false);
    }
    return make_sufficiency(SufficiencyStatus.Sufficient, DiagnosticOperation.NoOperation, EvidenceGap.NoGap, true);
}

fn diagnostic_loop(input: DiagnosticLoopInput) -> (result: DiagnosticLoopDecision) {
    let facts: EvidenceFacts = evidence_facts(input.evidence);
    let decision: SufficiencyDecision = sufficiency(SufficiencyInput {
        has_failure_identity: facts.failure_anchor_present,
        has_operation_identity: facts.operation_identity_present,
        observation_complete: facts.observation_complete,
        provenance_observed: facts.provenance_binding_present,
        replay_required: input.replay_required,
        minimization_required: input.minimization_required || facts.replay_mismatch,
    });
    let bounded_steps: u64 = bound_steps(input.step_budget);
    let stop: bool = decision.sufficient || bounded_steps == 0;
    return DiagnosticLoopDecision {
        status: decision.status,
        next_operation: decision.next_operation,
        evidence_gap: decision.evidence_gap,
        sufficient: decision.sufficient,
        stop: stop,
        bounded_steps: bounded_steps,
        replay_established: facts.replay_established,
        replay_mismatch: facts.replay_mismatch,
        minimization_established: facts.minimization_established,
    };
}

fn bound_steps(value: u64) -> (result: u64) {
    if value > 4 { return 4; }
    return value;
}

fn missing(value: bool) -> (result: bool) {
    if value { return false; }
    return true;
}

fn make_sufficiency(
    status: SufficiencyStatus,
    next_operation: DiagnosticOperation,
    evidence_gap: EvidenceGap,
    sufficient: bool
) -> (result: SufficiencyDecision) {
    return SufficiencyDecision {
        status: status,
        next_operation: next_operation,
        evidence_gap: evidence_gap,
        sufficient: sufficient,
    };
}

// RuntimeStatus is a nominal vocabulary for facts acquired by the host
// launcher. The semantic DebugOutcome is selected only here.
fn decide(input: DecisionInput) -> (result: Decision) {
    return match input.runtime_status {
        Returned => make_decision(returned_outcome(input)),
        RuntimeFailure => make_decision(runtime_failure_outcome(input)),
        Unsupported => make_decision(DebugOutcome.Unsupported),
        BudgetExhausted => make_decision(DebugOutcome.TimeoutOrBudgetExhaustion),
        InvalidRequest => make_decision(DebugOutcome.InvalidInvocation),
        CompileFailure => make_decision(DebugOutcome.CompileFailure),
        TestFailure => make_decision(DebugOutcome.TestFailure),
        InfrastructureFailure => make_decision(DebugOutcome.InfrastructureFailure),
    };
}

fn returned_outcome(input: DecisionInput) -> (result: DebugOutcome) {
    if input.assertion_failed { return DebugOutcome.AssertionFailure; }
    if input.effect_failed { return DebugOutcome.EffectFailure; }
    return DebugOutcome.Success;
}

fn runtime_failure_outcome(input: DecisionInput) -> (result: DebugOutcome) {
    if input.effect_failed { return DebugOutcome.EffectFailure; }
    return DebugOutcome.RuntimeFailure;
}

fn make_decision(outcome: DebugOutcome) -> (result: Decision) {
    return Decision {
        outcome: outcome,
        should_stop: stop_for(outcome),
    };
}

fn stop_for(outcome: DebugOutcome) -> (result: bool) {
    return match outcome {
        Success => false,
        CompileFailure => true,
        RuntimeFailure => true,
        AssertionFailure => true,
        EffectFailure => true,
        TimeoutOrBudgetExhaustion => true,
        Unsupported => true,
        InvalidInvocation => true,
        InfrastructureFailure => true,
        TestFailure => true,
    };
}

// Bounded witness materialization and replay planning.  The host supplies
// already-bound facts and byte/event counts; this module decides whether a
// witness is admissible and which bounded follow-up operations are requested.
enum WitnessStatus { Ready, Incomplete, Rejected }

fn bounded_count(value: u64, limit: u64) -> (result: u64) {
    if value > limit { return limit; }
    return value;
}

record WitnessMaterializationInput {
    failure_identity_present: bool,
    operation_identity_present: bool,
    observation_complete: bool,
    provenance_observed: bool,
    event_count: u64,
    value_count: u64,
    byte_count: u64,
    max_events: u64,
    max_values: u64,
    max_bytes: u64,
    replay_required: bool,
    minimization_required: bool
}

record WitnessMaterializationPlan {
    status: WitnessStatus,
    replay_requested: bool,
    minimization_requested: bool,
    retained_events: u64,
    retained_values: u64,
    retained_bytes: u64,
    reason_code: u64
}

fn materialize_witness(input: WitnessMaterializationInput) -> (result: WitnessMaterializationPlan) {
    if input.max_events == 0 || input.max_values == 0 || input.max_bytes == 0 {
        return WitnessMaterializationPlan {
            status: WitnessStatus.Rejected,
            replay_requested: false,
            minimization_requested: false,
            retained_events: 0,
            retained_values: 0,
            retained_bytes: 0,
            reason_code: 30
        };
    }
    if input.event_count > input.max_events
        || input.value_count > input.max_values
        || input.byte_count > input.max_bytes {
        return WitnessMaterializationPlan {
            status: WitnessStatus.Rejected,
            replay_requested: false,
            minimization_requested: false,
            retained_events: bounded_count(input.event_count, input.max_events),
            retained_values: bounded_count(input.value_count, input.max_values),
            retained_bytes: bounded_count(input.byte_count, input.max_bytes),
            reason_code: 31
        };
    }
    if missing(input.failure_identity_present)
        || missing(input.operation_identity_present)
        || missing(input.observation_complete)
        || missing(input.provenance_observed) {
        return WitnessMaterializationPlan {
            status: WitnessStatus.Incomplete,
            replay_requested: input.replay_required,
            minimization_requested: input.minimization_required,
            retained_events: input.event_count,
            retained_values: input.value_count,
            retained_bytes: input.byte_count,
            reason_code: 32
        };
    }
    return WitnessMaterializationPlan {
        status: WitnessStatus.Ready,
        replay_requested: input.replay_required,
        minimization_requested: input.minimization_required,
        retained_events: input.event_count,
        retained_values: input.value_count,
        retained_bytes: input.byte_count,
        reason_code: 0
    };
}
