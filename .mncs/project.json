{
  "schema_version": "mncs-family.repository-manifest/v0alpha1",
  "repository": "mncs-debug",
  "revision": 3,
  "manifest_location": "in-repository",
  "authority": {
    "note": "mncs-debug owns debugger semantics, witnesses, trace and capability truth; process/filesystem/transport code remains an explicit adapter boundary."
  },
  "organization": {
    "layout": "mncs.repository-layout/1",
    "surfaces": [
      {"path": "mncs_debug/", "class": "compatibility", "authority": "mncs-debug", "note": "Host protocol, process, observation, and presentation adapters around the native debugger decision core; it is not a second semantic authority.", "classification": {"authority": "compatibility", "lifecycle": "active", "boundary_kind": "process", "semantic_role": "compatibility-adapter"}},
      {"path": "mncs_debug/analysis.py", "class": "compatibility", "authority": "mncs-debug", "note": "Compatibility adapter: decodes bounded external artifacts and transports typed observations to the native decision core; it does not decide outcome or sufficiency.", "classification": {"authority": "compatibility", "lifecycle": "active", "boundary_kind": "process", "semantic_role": "compatibility-adapter"}},
      {"path": "native/mncs/debug/", "class": "canonical", "authority": "mncs-debug", "note": "Native debugger outcome, evidence sufficiency, escalation, and stop policy are canonical here.", "classification": {"authority": "canonical", "lifecycle": "active", "boundary_kind": "none", "semantic_role": "canonical-semantic"}},
      {"path": "mncs_debug/transport.py", "class": "host-boundary", "note": "Process, artifact, and protocol adaptation.", "classification": {"authority": "none", "lifecycle": "active", "boundary_kind": "process", "semantic_role": "platform-adapter"}},
      {"path": "pressures/", "class": "reference", "authority": "MNCS-Commons", "note": "Local pressure evidence; Commons owns lifecycle."}
    ]
  },
  "contracts": {
    "provides": [
      {"contract": "debugger", "version": "1", "kind": "structured-debugger", "stability": "experimental", "fingerprint_sources": ["mncs_debug/", "native/mncs/debug/", "schemas/debug-capabilities.schema.json"]}
    ],
    "consumes": [
      {"contract": "mncs-test.test-provider", "envelope": {"op": "any"}, "required": false},
      {"contract": "mncs-language.semantic-identity", "envelope": {"op": "any"}, "required": true}
    ],
    "tests": [
      {"test": "debug-tests", "covers": ["debugger"], "obligation": "self", "command": {"argv": ["python3", "-m", "unittest", "discover", "-s", "tests", "-p", "test_*.py"]}}
    ]
  }
}
