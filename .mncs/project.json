      {"path": "mncs_debug/transport.py", "class": "host-boundary", "note": "Process, artifact, and protocol adaptation.", "classification": {"authority": "none", "lifecycle": "active", "boundary_kind": "process", "semantic_role": "platform-adapter"}},
      {"path": "pressures/", "class": "reference", "authority": "MNCS-Commons", "note": "Local pressure evidence; Commons owns lifecycle.", "classification": {"authority": "reference", "lifecycle": "active", "boundary_kind": "none", "semantic_role": "reference"}}
