{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/epi13/mncs-debug/blob/main/schemas/debug-provenance.schema.json",
  "title": "MNCS Debug Provenance",
  "type": "object",
  "required": ["schema_version", "protocol_version", "provenance_id", "witness_id", "question", "claims", "completeness"],
  "properties": {
    "schema_version": {"const": "mncs.debug-provenance/1"},
    "protocol_version": {"const": 1},
    "provenance_id": {"type": "string"},
    "witness_id": {"type": "string"},
    "execution_identity": {"type": ["string", "null"]},
    "question": {"type": "string"},
    "target": {"type": "object"},
    "claims": {"type": "array", "items": {"type": "object"}},
    "completeness": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
