{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/epi13/mncs-debug/blob/main/schemas/debug-session.schema.json",
  "title": "MNCS Debug Session",
  "type": "object",
  "required": ["schema_version", "protocol_version", "session_id", "state", "witness_id", "capabilities"],
  "properties": {
    "schema_version": {"const": "mncs.debug-session/1"},
    "protocol_version": {"const": 1},
    "session_id": {"type": "string"},
    "state": {"enum": ["open", "closed", "invalid"]},
    "witness_id": {"type": "string"},
    "execution_identity": {"type": ["string", "null"]},
    "capabilities": {"type": "object"},
    "active_frame": {"type": ["object", "null"]},
    "transport": {"type": "object"}
  },
  "additionalProperties": true
}
