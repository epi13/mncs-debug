{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/epi13/mncs-debug/blob/main/schemas/debug-phases.schema.json",
  "title": "MNCS Debug Compiler Phases",
  "type": "object",
  "required": ["schema_version", "protocol_version", "phases_id", "witness_id", "status", "kind", "compilation", "passes", "resolutions"],
  "properties": {
    "schema_version": {"const": "mncs.debug-phases/1"},
    "protocol_version": {"const": 1},
    "phases_id": {"type": "string"},
    "witness_id": {"type": "string"},
    "status": {"enum": ["complete", "blocked"]},
    "reason": {"type": "string"},
    "kind": {"type": "string"},
    "program": {"type": "object"},
    "compilation": {"type": "object"},
    "stages": {"type": "object"},
    "passes": {"type": "array"},
    "pass_count": {"type": "integer"},
    "resolutions": {"type": ["object", "array"]},
    "unresolved": {"type": "object"},
    "static": {"type": "object"},
    "collection_errors": {"type": "array"}
  },
  "additionalProperties": true
}
